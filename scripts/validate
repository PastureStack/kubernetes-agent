#!/bin/bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "${repo_root}"

for script in scripts/build scripts/ci scripts/collect-go-licenses scripts/entry scripts/integration-kubernetes scripts/package scripts/test scripts/validate scripts/version; do
    bash -n "${script}"
done

go mod verify
go mod tidy
git diff --exit-code -- go.mod go.sum
go vet -mod=mod ./...

for module in third_party/control-api-client third_party/event-subscriber third_party/platform-metadata-client; do
    (
        cd "${module}"
        go mod verify
        go mod tidy
        git diff --exit-code -- go.mod go.sum
        go vet -mod=mod ./...
    )
done

unformatted=$(find . -path './.git' -prune -o -name '*.go' -type f -print | xargs gofmt -l)
if [ -n "${unformatted}" ]; then
    echo "${unformatted}" >&2
    exit 1
fi

required_markers=(
    'go 1.26.0'
    'toolchain go1.27.3'
    'FROM docker:29.9.2-cli@sha256:000bb62ff495f986c9f5578eb67cc2cb98b91138eda81d7762d5371eb8a497fe AS snapshot-ca-certificates'
    'FROM ubuntu:26.04@sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b'
    "UBUNTU_APT_SNAPSHOT='20260808T000000Z'"
    'apt-get --snapshot "${UBUNTU_APT_SNAPSHOT}" update'
    'GO_VERSION=1.27.3'
    'DOCKER_VERSION=29.9.2'
    'FROM gcr.io/distroless/static-debian12@sha256:4b2a093ef4649bccd586625090a3c668b254cfe180dee54f4c94f3e9bd7e381e'
    'USER 65532:65532'
    'org.opencontainers.image.revision="${SOURCE_REVISION}"'
    'config.ContentType = "application/json"'
    'truststore.ConfigurePlatformCA()'
    'go mod download all'
    'cache.WaitForCacheSync'
	'go test -mod=mod -race -count=1 ./...'
	'PLATFORM_CA_ROOT must be an approved control-platform CA path'
	'No workers available, dropping event'
)
for marker in "${required_markers[@]}"; do
    if ! grep -R -Fq -- "${marker}" go.mod Dockerfile.dapper package scripts kubernetesclient watchevents truststore third_party .github main.go; then
        echo "KUBERNETES_AGENT_REQUIRED_MARKER_MISSING marker=${marker}" >&2
        exit 1
    fi
done

grep -Fq 'k8s.io/client-go v0.36.4' go.mod
grep -Fq 'github.com/PastureStack/control-api-client v0.0.0' go.mod
grep -Fq 'github.com/PastureStack/event-subscriber v0.0.0' go.mod
grep -Fq 'github.com/PastureStack/platform-metadata-client v0.0.0' go.mod

if grep -R --include='*.go' --include='go.mod' -E 'github\.com/rancher/(go-rancher|go-rancher-metadata)|github\.com/pkg/errors' .; then
    echo "KUBERNETES_AGENT_UNMAINTAINED_ACTIVE_DEPENDENCY_PRESENT" >&2
    exit 1
fi

if [ -d vendor ] || [ -e trash.conf ] || [ -e dockerclient/docker_client.go ]; then
    echo "KUBERNETES_AGENT_STALE_VENDOR_OR_DOCKER_CLIENT_PRESENT" >&2
    exit 1
fi
if grep -R --exclude=validate -E '[vV]?[0-9]+\.[0-9]+\.[0-9]+-(rancher|pasturestack)([._-]?[0-9A-Za-z]+)*|GO111MODULE=off|GO15VENDOREXPERIMENT' \
	.github README.md SECURITY.md COMPATIBILITY.md Dockerfile.dapper Makefile package scripts; then
	echo "KUBERNETES_AGENT_STALE_BRANDED_VERSION_OR_MODULE_MODE_PRESENT" >&2
    exit 1
fi
if grep -R --exclude=validate -E 'GO_TEST_RACE=false|go test .*\$\{test_flags\[@\]\}' .github scripts Dockerfile.dapper; then
	echo "KUBERNETES_AGENT_RACE_GATE_CAN_BE_DISABLED" >&2
	exit 1
fi
# Build-only extraction stages may use packaging tools; the final runtime may not.
final_stage=$(awk '/^FROM / { stage=$0; body="" } { body=body $0 "\n" } END { print body }' package/Dockerfile)
if ! printf '%s\n' "$final_stage" | grep -Fxq 'FROM scratch' || \
    printf '%s\n' "$final_stage" | grep -Eq '^FROM (ubuntu|alpine|debian):|^RUN |ENTRYPOINT \["/.*sh"'; then
    echo "KUBERNETES_AGENT_RUNTIME_PACKAGE_MANAGER_OR_SHELL_PRESENT" >&2
    exit 1
fi
grep -Fq 'COPY --from=security-rootfs /rootfs/ /' package/Dockerfile

if grep -R -E 'ghcr\.io/[^/]+/[^:[:space:]]+@sha256:' README.md SECURITY.md COMPATIBILITY.md package scripts; then
    echo "KUBERNETES_AGENT_USER_VISIBLE_IMAGE_DIGEST_PRESENT" >&2
    exit 1
fi

source package/ubuntu-apt.lock
test "${UBUNTU_APT_SNAPSHOT}" = '20260808T000000Z'

build_vex=security/dapper.openvex.json
jq -e '
    .["@context"] == "https://openvex.dev/ns/v0.2.0" and
    .version == 2 and
    .statements == []
' "${build_vex}" >/dev/null

security_workflow=.github/workflows/security-release-gate.yml
for marker in \
    'workflow_dispatch:' \
    'actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1' \
    'actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a' \
    'TRIVY_IMAGE: aquasec/trivy:0.74.0@sha256:62b1e65e8869bc4b4c6aa4fa2b21595256c7c2f6018a9d9ad61caf87187c1969' \
    'KUBERNETES_SERVER_VERSION: v1.36.4' \
    'KUBE_APISERVER_SHA256: 90939ee07af61ac3701c665647f9ce27f2f988f5c7fff406aa5794fd3e6328a6' \
    'KUBECTL_SHA256: 8b8f088da2dab964f853b38464033b1be15ede2839eca751482357c45abdd05a' \
    'ETCD_TEST_IMAGE: quay.io/coreos/etcd:v3.7.1@sha256:3c66a5191d37a11af19f50ad49beed162a988bd1752eabc9fe6b164f7ee443e5' \
    'run: scripts/integration-kubernetes' \
    'go run golang.org/x/vuln/cmd/govulncheck@v1.7.0' \
	'select(.finding?.trace[-1]?.function != null)' \
    'diff -u dist/locked-go-modules.tsv dist/runtime-license-modules.tsv' \
    '--vex /source/security/dapper.openvex.json' \
    'dapper-applicable-scan.json' \
    '.build_environment.applicable.critical == 0' \
	'.build_environment.applicable.high == 0' \
    'retention-days: 7' \
    'Enforce the recorded security result'; do
    if ! grep -Fq -- "${marker}" "${security_workflow}"; then
        echo "KUBERNETES_AGENT_SECURITY_WORKFLOW_MARKER_MISSING marker=${marker}" >&2
        exit 1
    fi
done
if grep -Eq '^[[:space:]]+(pull_request|schedule):' "${security_workflow}" || \
    grep -Eq 'docker[[:space:]]+push|gh[[:space:]]+release[[:space:]]+create' "${security_workflow}" || \
    grep -E '^[[:space:]]+uses:' "${security_workflow}" | grep -Ev '@[0-9a-f]{40}([[:space:]]+#.*)?$'; then
    echo "KUBERNETES_AGENT_SECURITY_WORKFLOW_POLICY_VIOLATION" >&2
    exit 1
fi

codeql_workflow=.github/workflows/codeql-verification.yml
for marker in \
    "'verification/kubernetes-agent-*'" \
    'github/codeql-action/init@db488ddef3bf6cb639b32c2e9a7c0a7ea8271d28 # v4.37.8' \
    'github/codeql-action/analyze@db488ddef3bf6cb639b32c2e9a7c0a7ea8271d28 # v4.37.8' \
    'build-mode: manual' \
    'upload: never' \
    'codeql_critical_high' \
    'git merge-base --is-ancestor 63aadf22a77e2a452ee03c38159740835dc313cf "$GITHUB_SHA"'; do
    if ! grep -Fq -- "${marker}" "${codeql_workflow}"; then
		echo "KUBERNETES_AGENT_CODEQL_WORKFLOW_MARKER_MISSING marker=${marker}" >&2
		exit 1
	fi
done
if grep -E '^[[:space:]]+uses:' "${codeql_workflow}" | grep -Ev '@[0-9a-f]{40}([[:space:]]+#.*)?$'; then
	echo "KUBERNETES_AGENT_CODEQL_WORKFLOW_POLICY_VIOLATION" >&2
	exit 1
fi

git diff --check
echo "KUBERNETES_AGENT_VALIDATION_OK"
