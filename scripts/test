#!/bin/bash
set -euo pipefail

cd $(dirname $0)/..

echo "Running Go unit tests"
export INCLUSTER_CONFIG=false
test_kubeconfig=$(mktemp)
cleanup() {
    rm -f "${test_kubeconfig}"
}
trap cleanup EXIT
export KUBECONFIG="${test_kubeconfig}"
cat > "${KUBECONFIG}" <<'EOF'
apiVersion: v1
kind: Config
clusters:
- cluster:
    api-version: v1
    insecure-skip-tls-verify: true
    server: "http://localhost:8080"
  name: "Default"
contexts:
- context:
    cluster: "Default"
    user: "Default"
  name: "Default"
current-context: "Default"
users:
- name: "Default"
  user:
    token: "test"
EOF
if [ "${RUN_LEGACY_K8S_INTEGRATION:-false}" = "true" ] && [ -z "${KUBERNETES_TEST_URL:-}" ]; then
    echo "KUBERNETES_TEST_URL is required when RUN_LEGACY_K8S_INTEGRATION=true" >&2
    exit 1
fi
go test -mod=mod -count=1 -v ./...

echo "Running embedded event subscriber tests"
(
    cd third_party/event-subscriber
    go test -mod=mod -count=1 -v ./...
)

echo "OK"
